---
import { getCollection, render } from "astro:content";
import PillarLayout from "../layouts/PillarLayout.astro";

// Root-level pillar pages: /context-engineering/, /spec-driven-development/,
// and so on. Explicit routes (/blog/, /learn/) take priority over this
// dynamic one, and getStaticPaths only emits slugs that exist in the
// `pillars` collection, so nothing else is caught here.
export async function getStaticPaths() {
  const pages = await getCollection("pillars", ({ data }) => !data.draft);
  const byId = new Map(pages.map((p) => [p.id, p]));

  return pages.map((page) => ({
    params: { slug: page.id },
    props: {
      page,
      // Resolved here rather than in the layout so a typo in `related`
      // fails the build instead of shipping a dead link.
      related: page.data.related.map((slug) => {
        const target = byId.get(slug);
        if (!target) {
          throw new Error(
            `pillar "${page.id}" lists related slug "${slug}", which is not a pillar page`,
          );
        }
        return { href: `/${target.id}/`, label: target.data.heading };
      }),
    },
  }));
}

const { page, related } = Astro.props;
const { Content, headings } = await render(page);
---

<PillarLayout
  title={page.data.title}
  heading={page.data.heading}
  description={page.data.description}
  updatedDate={page.data.updatedDate}
  faq={page.data.faq}
  ogImage={page.data.ogImage}
  headings={headings}
  related={related}
  markdownTwin={`/${page.id}.md`}
>
  <Content />
</PillarLayout>
