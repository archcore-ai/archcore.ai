---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/content.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeScript from "../components/ThemeScript.astro";
import Analytics from "../components/Analytics.astro";

interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  faq?: FaqEntry[] | undefined;
  ogImage?: string | undefined;
  /** Path to the raw-markdown twin of this page, e.g. "/blog/foo.md". */
  markdownTwin?: string | undefined;
}

const SITE_URL = "https://archcore.ai";
const { title, description, pubDate, updatedDate, faq, ogImage, markdownTwin } =
  Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
// "/blog/claude-code-memory/" → section "blog", slug "claude-code-memory".
// Handed to the analytics script through the [data-article-end] marker.
const [articleSection = "blog", articleSlug = ""] = Astro.url.pathname
  .split("/")
  .filter(Boolean);
const image = ogImage
  ? new URL(ogImage, SITE_URL).href
  : `${SITE_URL}/og-image.png`;
const pageTitle = `${title} | Archcore`;
const modified = updatedDate ?? pubDate;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: modified.toISOString(),
  mainEntityOfPage: canonical,
  image,
  author: {
    "@type": "Organization",
    name: "Archcore",
    url: SITE_URL,
  },
  publisher: {
    "@type": "Organization",
    name: "Archcore",
    url: SITE_URL,
    logo: { "@type": "ImageObject", url: `${SITE_URL}/logo.png` },
  },
};

const faqSchema =
  faq && faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeScript />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="robots" content="index, follow" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {markdownTwin && <link rel="alternate" type="text/markdown" href={markdownTwin} />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Archcore" />
    <meta property="og:image" content={image} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@archcore_ai" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f1e8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1816" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    <Analytics />
  </head>
  <body>
    <SiteHeader />
    <main class="page">
      <article class="article">
        <h1>{title}</h1>
        <p class="article__meta">
          Published {fmt(pubDate)}
          {updatedDate && <> · Updated {fmt(updatedDate)}</>}
          {" "}· Archcore team
        </p>
        <slot />
        {/*
          End of the article body — reaching it reports article_read_completed.
          Deliberately before the FAQ and the CTA, so the event means "read the
          piece" rather than duplicating scroll_depth_reached at 100 %.
        */}
        <div
          data-article-end
          data-slug={articleSlug}
          data-section={articleSection}
          aria-hidden="true"
        />
        {faq && faq.length > 0 && (
          <section class="faq">
            <h2>FAQ</h2>
            {faq.map((f) => (
              <>
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </>
            ))}
          </section>
        )}
        <aside class="cta" data-analytics-cta="article_install">
          <p>
            Archcore keeps decisions, rules, specs, and plans as typed markdown
            documents in your repo — loaded into Claude Code, Cursor, and any
            MCP agent before they edit.
          </p>
          <a href="/#install">Install Archcore →</a>
        </aside>
      </article>
    </main>
    <SiteFooter />
    <script>
      // DESIGN.md: every command snippet gets a copy button.
      document.querySelectorAll(".article pre").forEach((pre) => {
        const btn = document.createElement("button");
        btn.className = "copy-btn";
        btn.type = "button";
        btn.textContent = "Copy";
        // Picked up by the delegated copy tracker in analytics/core.ts, which
        // matches on this attribute rather than the "copy-btn" class name.
        btn.dataset.analyticsCopy = "article_code_block";
        btn.addEventListener("click", () => {
          const text =
            pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
          navigator.clipboard.writeText(text.replace(/\n$/, "")).then(
            () => (btn.textContent = "Copied"),
            () => (btn.textContent = "Copy failed"),
          );
          setTimeout(() => (btn.textContent = "Copy"), 1500);
        });
        pre.appendChild(btn);
      });
    </script>
  </body>
</html>
