---
import PageIntro from "../components/PageIntro.astro";
import SiteLayout from "./SiteLayout.astro";
import SeoMeta from "../components/SeoMeta.astro";
import RecipeMark from "../components/RecipeMark.astro";

interface CatalogItem {
  href: string;
  title: string;
  summary: string;
  category: string;
  status: string;
  /**
   * Russian card copy. Present when the entry carries a `ru` block; the site
   * locale switch swaps the text client-side, as it does for the chrome.
   */
  titleRu?: string | undefined;
  summaryRu?: string | undefined;
  categoryRu?: string | undefined;
  statusRu?: string | undefined;
  tools: {
    name: string;
    icon?: string | undefined;
    iconDark?: string | undefined;
  }[];
}

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  /** Russian heading and intro. The head stays English — crawlers read it. */
  h1Ru?: string | undefined;
  introRu?: string | undefined;
  items: CatalogItem[];
}

const SITE_URL = "https://archcore.ai";
const { title, description, h1, intro, h1Ru, introRu, items } = Astro.props;
const canonical = `${SITE_URL}/integrations/`;
const image = `${SITE_URL}/og/integrations.png`;

const listingSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: h1,
  description,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "Archcore", url: SITE_URL },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: items.map((item, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      url: `${SITE_URL}${item.href}`,
      name: item.title,
    })),
  },
};
---

<SiteLayout>
  <Fragment slot="head">
    <SeoMeta
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={h1}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(listingSchema)}
    />
  </Fragment>
  <main
    id="main-content"
    class="page page--listing"
    data-hide-integration-branding
  >
    <PageIntro
      title={h1}
      description={intro}
      titleRu={h1Ru}
      descriptionRu={introRu}
    />

    <ul class="catalog-grid">
      {
        items.map((item) => (
          <li class="catalog-card">
            <a href={item.href} class="catalog-card__link">
              <RecipeMark tools={item.tools} />
              <h2
                class="catalog-card__title"
                data-en={item.titleRu ? item.title : undefined}
                data-ru={item.titleRu}
              >
                {item.title}
              </h2>
              <p
                class="catalog-card__summary"
                data-en={item.summaryRu ? item.summary : undefined}
                data-ru={item.summaryRu}
              >
                {item.summary}
              </p>
              <p class="catalog-card__foot">
                <span
                  class="badge"
                  data-en={item.categoryRu ? item.category : undefined}
                  data-ru={item.categoryRu}
                >
                  {item.category}
                </span>
                <span
                  class="badge badge--quiet"
                  data-en={item.statusRu ? item.status : undefined}
                  data-ru={item.statusRu}
                >
                  {item.status}
                </span>
              </p>
              <span class="catalog-card__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <slot />
  </main>
</SiteLayout>
