---
import PageIntro from "../components/PageIntro.astro";
import SiteLayout from "./SiteLayout.astro";
import RecipeMark from "../components/RecipeMark.astro";

interface CatalogItem {
  href: string;
  title: string;
  summary: string;
  category: string;
  status: string;
  tools: {
    name: string;
    icon?: string | undefined;
    iconDark?: string | undefined;
  }[];
}

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  items: CatalogItem[];
}

const SITE_URL = "https://archcore.ai";
const { title, description, h1, intro, items } = Astro.props;
const canonical = `${SITE_URL}/integrations/`;

const listingSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: h1,
  description,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "Archcore", url: SITE_URL },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: items.map((item, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      url: `${SITE_URL}${item.href}`,
      name: item.title,
    })),
  },
};
---

<SiteLayout>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Archcore" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@archcore_ai" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(listingSchema)}
    />
  </Fragment>
  <main id="main-content" class="page page--listing">
    <PageIntro title={h1} description={intro} />

    <ul class="catalog-grid">
      {
        items.map((item) => (
          <li class="catalog-card">
            <a href={item.href} class="catalog-card__link">
              <RecipeMark tools={item.tools} />
              <h2 class="catalog-card__title">{item.title}</h2>
              <p class="catalog-card__summary">{item.summary}</p>
              <p class="catalog-card__foot">
                <span class="badge">{item.category}</span>
                <span class="badge badge--quiet">{item.status}</span>
              </p>
              <span class="catalog-card__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <slot />
  </main>
</SiteLayout>
