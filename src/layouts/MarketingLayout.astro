---
import SiteLayout from "./SiteLayout.astro";
import metadata from "../data/marketing-meta.json";
import { productCopy } from "../data/product-copy";
interface Props {
  page: keyof typeof metadata;
  localizable?: boolean;
}
const { page, localizable = false } = Astro.props;
const meta = metadata[page];
const description =
  productCopy[meta.descriptionKey as keyof typeof productCopy].message;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<SiteLayout localizable={localizable}>
  <Fragment slot="head">
    <title>{meta.title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Archcore" />
    <meta property="og:image" content={meta.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@archcore_ai" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={meta.ogImage} />
    {
      meta.schemas.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(
            schema["@type"] === "SoftwareApplication"
              ? { ...schema, description: productCopy.homeDescription.message }
              : schema
          )}
        />
      ))
    }
  </Fragment>
  <slot />
</SiteLayout>
