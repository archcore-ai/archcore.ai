---
import SiteLayout from "./SiteLayout.astro";
import RecipeMark from "../components/RecipeMark.astro";
import RecipeSetup from "../components/RecipeSetup.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { recipeLabels as L } from "../data/recipe-labels";

// Static recipe page. Evidence and source details remain available on demand.
interface Tool {
  name: string;
  url: string;
  role: string;
  icon?: string | undefined;
  iconDark?: string | undefined;
}

interface EvidenceRecord {
  digest: string;
  date: Date;
  host: string;
  model: string;
  scenario: string;
  outcome: "passed" | "failed" | "unexecuted";
  notes?: string | undefined;
}

/** Russian copy for this recipe. Absent fields stay English. */
interface RussianCopy {
  heading?: string | undefined;
  summary?: string | undefined;
  category?: string | undefined;
  toolRoles: Record<string, string>;
  workflow?:
    | {
        heading: string;
        steps: { title: string; description: string }[];
        note: string;
      }
    | undefined;
  pilot?:
    | {
        heading: string;
        summary: string;
        limitation: string;
        findings: { scenario: string; result: string; caveat: string }[];
      }
    | undefined;
  limits: string[];
}

interface Props {
  title: string;
  heading: string;
  description: string;
  summary: string;
  category: string;
  updatedDate: Date;
  recipe: string;
  digest: string;
  instructions: string;
  downloadHref: string;
  markdownTwin: string;
  sourceRepo: string;
  sourceLabel: string;
  sourcePath: string;
  sourceRevision: string | null;
  tools: Tool[];
  evidence: EvidenceRecord[];
  limits: string[];
  maintainer: string;
  workflow?:
    | {
        heading: string;
        steps: { title: string; description: string }[];
        note: string;
      }
    | undefined;
  pilot?:
    | {
        heading: string;
        summary: string;
        limitation: string;
        findings: { scenario: string; result: string; caveat: string }[];
      }
    | undefined;
  ru?: RussianCopy | undefined;
  /** True when the page also carries a Russian prose body in the `ru` slot. */
  hasRussianBody?: boolean | undefined;
}

const SITE_URL = "https://archcore.ai";
const {
  title,
  heading,
  description,
  summary,
  category,
  updatedDate,
  recipe,
  digest,
  instructions,
  downloadHref,
  markdownTwin,
  sourceRepo,
  sourceLabel,
  sourcePath,
  sourceRevision,
  tools,
  evidence,
  limits,
  maintainer,
  pilot,
  workflow,
  ru,
  hasRussianBody = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const image = `${SITE_URL}/og-image.png`;
const shortDigest = digest.slice(0, 12);

const DATE_OPTIONS = {
  year: "numeric",
  month: "long",
  day: "numeric",
} as const;
const fmt = (d: Date) => d.toLocaleDateString("en-US", DATE_OPTIONS);
const fmtRu = (d: Date) => d.toLocaleDateString("ru-RU", DATE_OPTIONS);

const outcomeLabel = {
  passed: L.outcomePassed,
  failed: L.outcomeFailed,
  unexecuted: L.outcomeUnexecuted,
};

// Status is derived, never authored. No evidence means experimental, and no
// amount of editing this page can make it say otherwise.
const verified = evidence.filter((e) => e.outcome === "passed");
const status = verified.length > 0 ? L.statusVerified : L.statusExperimental;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: heading,
  headline: title,
  description,
  dateModified: updatedDate.toISOString(),
  url: canonical,
  primaryImageOfPage: image,
  isPartOf: { "@type": "WebSite", name: "Archcore", url: SITE_URL },
  publisher: {
    "@type": "Organization",
    name: "Archcore",
    url: SITE_URL,
    logo: { "@type": "ImageObject", url: `${SITE_URL}/logo.png` },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Integrations",
      item: `${SITE_URL}/integrations/`,
    },
    { "@type": "ListItem", position: 2, name: heading, item: canonical },
  ],
};
---

<SiteLayout>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownTwin} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Archcore" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@archcore_ai" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(pageSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>
  <main
    id="main-content"
    class="page recipe-page"
    data-recipe-root
    data-hide-integration-branding
    data-recipe={recipe}
    data-digest={digest}
  >
    <nav class="recipe-crumb" aria-label="Breadcrumb">
      <a
        href="/integrations/"
        data-en={L.allIntegrations.en}
        data-ru={L.allIntegrations.ru}>{L.allIntegrations.en}</a
      >
    </nav>

    <header class="recipe-head">
      <div class="recipe-head__identity">
        <RecipeMark tools={tools} />
        <span class="badge" data-en={status.en} data-ru={status.ru}
          >{status.en}</span
        >
      </div>
      <div class="recipe-head__content">
        <h1 data-en={ru?.heading ? heading : undefined} data-ru={ru?.heading}>
          {heading}
        </h1>
        <p
          class="recipe-head__summary"
          data-en={ru?.summary ? summary : undefined}
          data-ru={ru?.summary}
        >
          {summary}
        </p>
      </div>
      <button
        type="button"
        class="btn btn--primary recipe-head__install"
        data-recipe-install
        aria-haspopup="dialog"
        aria-controls="install"
        data-en={L.install.en}
        data-ru={L.install.ru}
        hidden>{L.install.en}</button
      >
      <noscript
        ><a
          class="btn btn--primary"
          href="#install"
          data-en={L.install.en}
          data-ru={L.install.ru}>{L.install.en}</a
        ></noscript
      >
    </header>

    <div class="recipe-toolbar">
      <nav
        class="recipe-tabs"
        aria-label={L.integrationGuide.en}
        data-en-label={L.integrationGuide.en}
        data-ru-label={L.integrationGuide.ru}
        data-recipe-tabs
      >
        <a
          id="recipe-tab-overview"
          href="#how-it-works"
          data-recipe-tab="how-it-works"
          data-en={L.tabOverview.en}
          data-ru={L.tabOverview.ru}>{L.tabOverview.en}</a
        >
        {
          pilot && (
            <a
              id="recipe-tab-pilot"
              href="#pilot-results"
              data-recipe-tab="pilot-results"
              data-en={L.tabBenefits.en}
              data-ru={L.tabBenefits.ru}
            >
              {L.tabBenefits.en}
            </a>
          )
        }
      </nav>
    </div>

    <section
      id="how-it-works"
      class="recipe-overview"
      aria-label={L.aboutIntegration.en}
      data-en-label={L.aboutIntegration.en}
      data-ru-label={L.aboutIntegration.ru}
      data-recipe-tab-panel
    >
      <div>
        <div
          class="recipe-prose"
          data-locale-block={hasRussianBody ? "en" : undefined}
        >
          <slot />
        </div>
        {
          hasRussianBody && (
            <div class="recipe-prose" lang="ru" data-locale-block="ru" hidden>
              <slot name="ru" />
            </div>
          )
        }
        <dl class="recipe-tools">
          {
            tools.map((tool) => (
              <div>
                <dt>
                  <a href={tool.url} target="_blank" rel="noopener noreferrer">
                    {tool.name} ↗
                  </a>
                </dt>
                <dd
                  data-en={ru?.toolRoles[tool.name] ? tool.role : undefined}
                  data-ru={ru?.toolRoles[tool.name]}
                >
                  {tool.role}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      {
        workflow && (
          <section
            class="recipe-workflow"
            aria-labelledby="recipe-workflow-heading"
          >
            <h2
              id="recipe-workflow-heading"
              data-en={ru?.workflow ? workflow.heading : undefined}
              data-ru={ru?.workflow?.heading}
            >
              {workflow.heading}
            </h2>
            <p
              class="recipe-workflow-intro"
              data-en={L.workflowIntro.en}
              data-ru={L.workflowIntro.ru}
            >
              {L.workflowIntro.en}
            </p>
            <ol>
              {workflow.steps.map((step, index) => (
                <li>
                  <span class="recipe-workflow-number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <div>
                    <h3
                      data-en={ru?.workflow ? step.title : undefined}
                      data-ru={ru?.workflow?.steps[index]?.title}
                    >
                      {step.title}
                    </h3>
                    <p
                      data-en={ru?.workflow ? step.description : undefined}
                      data-ru={ru?.workflow?.steps[index]?.description}
                    >
                      {step.description}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
            <p
              class="recipe-workflow-note"
              data-en={ru?.workflow ? workflow.note : undefined}
              data-ru={ru?.workflow?.note}
            >
              {workflow.note}
            </p>
          </section>
        )
      }
      {
        pilot && (
          <div class="recipe-overview-result">
            <a
              href="#pilot-results"
              data-en={L.seeBenefits.en}
              data-ru={L.seeBenefits.ru}
            >
              {L.seeBenefits.en}
            </a>
          </div>
        )
      }
    </section>
    <RecipeSetup
      tools={tools}
      downloadHref={downloadHref}
      instructions={instructions}
      verified={verified.length > 0}
    />

    {
      pilot && (
        <section
          id="pilot-results"
          class="recipe-pilot"
          data-recipe-tab-panel
          aria-labelledby="recipe-impact-heading"
        >
          <header class="recipe-pilot-heading">
            <div>
              <p
                class="recipe-eyebrow"
                data-en={L.tabBenefits.en}
                data-ru={L.tabBenefits.ru}
              >
                {L.tabBenefits.en}
              </p>
              <h2
                id="recipe-impact-heading"
                data-en={ru?.pilot ? pilot.heading : undefined}
                data-ru={ru?.pilot?.heading}
              >
                {pilot.heading}
              </h2>
            </div>
            <p
              data-en={ru?.pilot ? pilot.summary : undefined}
              data-ru={ru?.pilot?.summary}
            >
              {pilot.summary}
            </p>
          </header>
          <dl class="recipe-findings">
            {pilot.findings.map((finding, index) => (
              <div>
                <dt
                  data-en={ru?.pilot ? finding.scenario : undefined}
                  data-ru={ru?.pilot?.findings[index]?.scenario}
                >
                  {finding.scenario}
                </dt>
                <dd>
                  <p
                    data-en={ru?.pilot ? finding.result : undefined}
                    data-ru={ru?.pilot?.findings[index]?.result}
                  >
                    {finding.result}
                  </p>
                  <p
                    class="recipe-finding-caveat"
                    data-en={ru?.pilot ? finding.caveat : undefined}
                    data-ru={ru?.pilot?.findings[index]?.caveat}
                  >
                    {finding.caveat}
                  </p>
                </dd>
              </div>
            ))}
          </dl>
          <aside
            class="recipe-pilot-limit"
            aria-label={L.limits.en}
            data-en-label={L.limits.en}
            data-ru-label={L.limits.ru}
          >
            <h3 data-en={L.limits.en} data-ru={L.limits.ru}>
              {L.limits.en}
            </h3>
            <p
              data-en={ru?.pilot ? pilot.limitation : undefined}
              data-ru={ru?.pilot?.limitation}
            >
              {pilot.limitation}
            </p>
          </aside>
        </section>
      )
    }

    <ClosingCta analyticsCta="recipe_install" newTab localized />

    <dialog
      class="recipe-dialog"
      id="recipe-details"
      aria-labelledby="recipe-dialog-title"
    >
      <div class="recipe-dialog__header">
        <div>
          <p class="recipe-eyebrow">{heading}</p><h2
            id="recipe-dialog-title"
            data-en={L.sourceAndVerification.en}
            data-ru={L.sourceAndVerification.ru}
          >
            {L.sourceAndVerification.en}
          </h2>
        </div>
        <form method="dialog">
          <button
            class="recipe-dialog__close"
            aria-label={L.closeDetails.en}
            data-en-label={L.closeDetails.en}
            data-ru-label={L.closeDetails.ru}
            autofocus>✕</button
          >
        </form>
      </div>
      <div class="recipe-dialog__body">
        <dl class="recipe-facts">
          <div>
            <dt data-en={L.factCategory.en} data-ru={L.factCategory.ru}>
              {L.factCategory.en}
            </dt><dd
              data-en={ru?.category ? category : undefined}
              data-ru={ru?.category}
            >
              {category}
            </dd>
          </div>
          <div>
            <dt data-en={L.factRevision.en} data-ru={L.factRevision.ru}>
              {L.factRevision.en}
            </dt><dd>
              <code title={digest}>{shortDigest}</code>
            </dd>
          </div>
          <div>
            <dt data-en={L.factSource.en} data-ru={L.factSource.ru}>
              {L.factSource.en}
            </dt><dd>
              {
                sourceRevision ? (
                  <a
                    href={`${sourceRepo}/blob/${sourceRevision}/${sourcePath}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {sourcePath}
                  </a>
                ) : (
                  <>
                    <a
                      href={sourceRepo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {sourceLabel}
                    </a>{" "}
                    · <code>{sourcePath}</code> ·{" "}
                    <span
                      data-en={L.revisionUnpublished.en}
                      data-ru={L.revisionUnpublished.ru}
                    >
                      {L.revisionUnpublished.en}
                    </span>
                  </>
                )
              }
            </dd>
          </div>
          <div>
            <dt data-en={L.factMaintainer.en} data-ru={L.factMaintainer.ru}>
              {L.factMaintainer.en}
            </dt><dd>{maintainer}</dd>
          </div>
          <div>
            <dt data-en={L.factUpdated.en} data-ru={L.factUpdated.ru}>
              {L.factUpdated.en}
            </dt><dd data-en={fmt(updatedDate)} data-ru={fmtRu(updatedDate)}>
              {fmt(updatedDate)}
            </dd>
          </div>
        </dl>
        <h2 data-en={L.verification.en} data-ru={L.verification.ru}>
          {L.verification.en}
        </h2>
        {
          evidence.length === 0 ? (
            <p data-en={L.noRuns.en} data-ru={L.noRuns.ru}>
              {L.noRuns.en}
            </p>
          ) : (
            <div
              class="recipe-evidence-scroll"
              tabindex="0"
              role="region"
              aria-label={L.verificationRecords.en}
              data-en-label={L.verificationRecords.en}
              data-ru-label={L.verificationRecords.ru}
            >
              <table>
                <thead>
                  <tr>
                    <>
                      {[
                        L.colDate,
                        L.colAgent,
                        L.colModel,
                        L.colScenario,
                        L.colOutcome,
                      ].map((column) => (
                        <th data-en={column.en} data-ru={column.ru}>
                          {column.en}
                        </th>
                      ))}
                    </>
                  </tr>
                </thead>
                <tbody>
                  {evidence.map((record) => (
                    <tr>
                      <td
                        data-en={fmt(record.date)}
                        data-ru={fmtRu(record.date)}
                      >
                        {fmt(record.date)}
                      </td>
                      <td>{record.host}</td>
                      <td>{record.model}</td>
                      <td>{record.scenario}</td>
                      <td
                        data-en={outcomeLabel[record.outcome].en}
                        data-ru={outcomeLabel[record.outcome].ru}
                      >
                        {outcomeLabel[record.outcome].en}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
        {
          limits.length > 0 && (
            <ul>
              {limits.map((limit, index) => (
                <li
                  data-en={ru?.limits[index] ? limit : undefined}
                  data-ru={ru?.limits[index]}
                >
                  {limit}
                </li>
              ))}
            </ul>
          )
        }
        <h2 data-en={L.updateHeading.en} data-ru={L.updateHeading.ru}>
          {L.updateHeading.en}
        </h2>
        <p data-en={L.updateBody.en} data-ru={L.updateBody.ru}>
          {L.updateBody.en}
        </p>
      </div>
    </dialog>
  </main>
</SiteLayout>

<script>
  const tabList = document.querySelector<HTMLElement>("[data-recipe-tabs]");
  const tabs = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-recipe-tab]"),
  ];
  const tabPanels = [
    ...document.querySelectorAll<HTMLElement>("[data-recipe-tab-panel]"),
  ];

  if (tabList && tabs.length && tabPanels.length) {
    const activate = (id: string) => {
      for (const tab of tabs) {
        const selected = tab.dataset.recipeTab === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const panel of tabPanels) panel.hidden = panel.id !== id;
    };
    tabList.setAttribute("role", "tablist");
    for (const tab of tabs) {
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", tab.dataset.recipeTab!);
      const panel = tabPanels.find(
        (panel) => panel.id === tab.dataset.recipeTab
      );
      panel?.setAttribute("role", "tabpanel");
      panel?.setAttribute("aria-labelledby", tab.id);
      if (panel) panel.tabIndex = 0;
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        activate(tab.dataset.recipeTab!);
        history.replaceState(null, "", tab.hash);
      });
      tab.addEventListener("keydown", (event) => {
        if (event.key === " ") {
          event.preventDefault();
          tab.click();
          return;
        }
        const index = tabs.indexOf(tab);
        const next =
          event.key === "ArrowRight"
            ? (index + 1) % tabs.length
            : event.key === "ArrowLeft"
              ? (index - 1 + tabs.length) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        tabs[next].click();
        tabs[next].focus();
      });
    }
    const syncHash = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (target?.closest("#install")) return;
      const panel = target?.closest<HTMLElement>("[data-recipe-tab-panel]");
      activate(panel?.id ?? "how-it-works");
      if (target && panel && target !== panel) target.scrollIntoView();
    };
    activate("how-it-works");
    syncHash();
    window.addEventListener("hashchange", syncHash);
  }
</script>
