---
import SiteLayout from "./SiteLayout.astro";
import RecipeMark from "../components/RecipeMark.astro";
import RecipeSetup from "../components/RecipeSetup.astro";
import ClosingCta from "../components/ClosingCta.astro";

// Static recipe page. Evidence and source details remain available on demand.
interface Tool {
  name: string;
  url: string;
  role: string;
  icon?: string | undefined;
  iconDark?: string | undefined;
}

interface EvidenceRecord {
  digest: string;
  date: Date;
  host: string;
  model: string;
  scenario: string;
  outcome: "passed" | "failed" | "unexecuted";
  notes?: string | undefined;
}

interface Props {
  title: string;
  heading: string;
  description: string;
  summary: string;
  category: string;
  updatedDate: Date;
  recipe: string;
  digest: string;
  instructions: string;
  downloadHref: string;
  markdownTwin: string;
  sourceRepo: string;
  sourcePath: string;
  sourceRevision: string | null;
  tools: Tool[];
  evidence: EvidenceRecord[];
  limits: string[];
  maintainer: string;
  workflow?:
    | {
        heading: string;
        steps: { title: string; description: string }[];
        note: string;
      }
    | undefined;
  pilot?:
    | {
        heading: string;
        summary: string;
        limitation: string;
        findings: { scenario: string; result: string; caveat: string }[];
      }
    | undefined;
}

const SITE_URL = "https://archcore.ai";
const {
  title,
  heading,
  description,
  summary,
  category,
  updatedDate,
  recipe,
  digest,
  instructions,
  downloadHref,
  markdownTwin,
  sourceRepo,
  sourcePath,
  sourceRevision,
  tools,
  evidence,
  limits,
  maintainer,
  pilot,
  workflow,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const image = `${SITE_URL}/og-image.png`;
const shortDigest = digest.slice(0, 12);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

// Status is derived, never authored. No evidence means experimental, and no
// amount of editing this page can make it say otherwise.
const verified = evidence.filter((e) => e.outcome === "passed");
const status = verified.length > 0 ? "Verified in part" : "Experimental";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: heading,
  headline: title,
  description,
  dateModified: updatedDate.toISOString(),
  url: canonical,
  primaryImageOfPage: image,
  isPartOf: { "@type": "WebSite", name: "Archcore", url: SITE_URL },
  publisher: {
    "@type": "Organization",
    name: "Archcore",
    url: SITE_URL,
    logo: { "@type": "ImageObject", url: `${SITE_URL}/logo.png` },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Integrations",
      item: `${SITE_URL}/integrations/`,
    },
    { "@type": "ListItem", position: 2, name: heading, item: canonical },
  ],
};
---

<SiteLayout>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownTwin} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Archcore" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@archcore_ai" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(pageSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>
  <main
    id="main-content"
    class="page recipe-page"
    data-recipe-root
    data-hide-integration-branding
    data-recipe={recipe}
    data-digest={digest}
  >
    <nav class="recipe-crumb" aria-label="Breadcrumb">
      <a href="/integrations/">← All integrations</a>
    </nav>

    <header class="recipe-head">
      <div class="recipe-head__identity">
        <RecipeMark tools={tools} />
        <span class="badge">{status}</span>
      </div>
      <div class="recipe-head__content">
        <h1>{heading}</h1>
        <p class="recipe-head__summary">{summary}</p>
      </div>
      <button
        type="button"
        class="btn btn--primary recipe-head__install"
        data-recipe-install
        aria-haspopup="dialog"
        aria-controls="install"
        hidden>Install</button
      >
      <noscript
        ><a class="btn btn--primary" href="#install">Install</a></noscript
      >
    </header>

    <div class="recipe-toolbar">
      <nav class="recipe-tabs" aria-label="Integration guide" data-recipe-tabs>
        <a
          id="recipe-tab-overview"
          href="#how-it-works"
          data-recipe-tab="how-it-works">How it works</a
        >
        {
          pilot && (
            <a
              id="recipe-tab-pilot"
              href="#pilot-results"
              data-recipe-tab="pilot-results"
            >
              Benefits &amp; limits
            </a>
          )
        }
      </nav>
    </div>

    <section
      id="how-it-works"
      class="recipe-overview"
      aria-label="About this integration"
      data-recipe-tab-panel
    >
      <div>
        <div class="recipe-prose"><slot /></div>
        <dl class="recipe-tools">
          {
            tools.map((tool) => (
              <div>
                <dt>
                  <a href={tool.url} target="_blank" rel="noopener noreferrer">
                    {tool.name} ↗
                  </a>
                </dt>
                <dd>{tool.role}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      {
        workflow && (
          <section
            class="recipe-workflow"
            aria-labelledby="recipe-workflow-heading"
          >
            <h2 id="recipe-workflow-heading">{workflow.heading}</h2>
            <p class="recipe-workflow-intro">
              The instructions ask your agent to:
            </p>
            <ol>
              {workflow.steps.map((step, index) => (
                <li>
                  <span class="recipe-workflow-number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="recipe-workflow-note">{workflow.note}</p>
          </section>
        )
      }
      {
        pilot && (
          <div class="recipe-overview-result">
            <a href="#pilot-results">See benefits and limits →</a>
          </div>
        )
      }
    </section>
    <RecipeSetup
      tools={tools}
      downloadHref={downloadHref}
      instructions={instructions}
      verificationNote={verified.length > 0
        ? "Verification covers recorded runs only"
        : "Experimental · Not yet verified"}
    />

    {
      pilot && (
        <section
          id="pilot-results"
          class="recipe-pilot"
          data-recipe-tab-panel
          aria-labelledby="recipe-impact-heading"
        >
          <header class="recipe-pilot-heading">
            <div>
              <p class="recipe-eyebrow">Benefits &amp; limits</p>
              <h2 id="recipe-impact-heading">{pilot.heading}</h2>
            </div>
            <p>{pilot.summary}</p>
          </header>
          <dl class="recipe-findings">
            {pilot.findings.map((finding) => (
              <div>
                <dt>{finding.scenario}</dt>
                <dd>
                  <p>{finding.result}</p>
                  <p class="recipe-finding-caveat">{finding.caveat}</p>
                </dd>
              </div>
            ))}
          </dl>
          <aside class="recipe-pilot-limit" aria-label="Limits">
            <h3>Limits</h3>
            <p>{pilot.limitation}</p>
          </aside>
        </section>
      )
    }

    <ClosingCta analyticsCta="recipe_install" newTab />

    <dialog
      class="recipe-dialog"
      id="recipe-details"
      aria-labelledby="recipe-dialog-title"
    >
      <div class="recipe-dialog__header">
        <div>
          <p class="recipe-eyebrow">{heading}</p><h2 id="recipe-dialog-title">
            Source &amp; verification
          </h2>
        </div>
        <form method="dialog">
          <button
            class="recipe-dialog__close"
            aria-label="Close details"
            autofocus>✕</button
          >
        </form>
      </div>
      <div class="recipe-dialog__body">
        <dl class="recipe-facts">
          <div><dt>Category</dt><dd>{category}</dd></div>
          <div>
            <dt>Instruction revision</dt><dd>
              <code title={digest}>{shortDigest}</code>
            </dd>
          </div>
          <div>
            <dt>Source</dt><dd>
              {
                sourceRevision ? (
                  <a
                    href={`${sourceRepo}/blob/${sourceRevision}/${sourcePath}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {sourcePath}
                  </a>
                ) : (
                  <>
                    <a
                      href={sourceRepo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Plugin repository
                    </a>{" "}
                    · <code>{sourcePath}</code> · This revision is not published
                    yet.
                  </>
                )
              }
            </dd>
          </div>
          <div><dt>Maintainer</dt><dd>{maintainer}</dd></div>
          <div><dt>Page updated</dt><dd>{fmt(updatedDate)}</dd></div>
        </dl>
        <h2>Verification</h2>
        {
          evidence.length === 0 ? (
            <p>No joint run has been recorded for this instruction revision.</p>
          ) : (
            <div
              class="recipe-evidence-scroll"
              tabindex="0"
              role="region"
              aria-label="Verification records"
            >
              <table>
                <thead>
                  <tr>
                    <>
                      <th>Date</th>
                      <th>Agent</th>
                      <th>Model</th>
                      <th>Scenario</th>
                      <th>Outcome</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {evidence.map((record) => (
                    <tr>
                      <td>{fmt(record.date)}</td>
                      <td>{record.host}</td>
                      <td>{record.model}</td>
                      <td>{record.scenario}</td>
                      <td>{record.outcome}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
        {
          limits.length > 0 && (
            <ul>
              {limits.map((limit) => (
                <li>{limit}</li>
              ))}
            </ul>
          )
        }
        <h2>Update or disconnect</h2>
        <p>
          To update, review changes to the instructions before replacing your
          copy. To disconnect, remove the added instructions from your project
          file. Both tools and their documents stay in place.
        </p>
      </div>
    </dialog>
  </main>
</SiteLayout>

<script>
  const tabList = document.querySelector<HTMLElement>("[data-recipe-tabs]");
  const tabs = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-recipe-tab]"),
  ];
  const tabPanels = [
    ...document.querySelectorAll<HTMLElement>("[data-recipe-tab-panel]"),
  ];

  if (tabList && tabs.length && tabPanels.length) {
    const activate = (id: string) => {
      for (const tab of tabs) {
        const selected = tab.dataset.recipeTab === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const panel of tabPanels) panel.hidden = panel.id !== id;
    };
    tabList.setAttribute("role", "tablist");
    for (const tab of tabs) {
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", tab.dataset.recipeTab!);
      const panel = tabPanels.find(
        (panel) => panel.id === tab.dataset.recipeTab
      );
      panel?.setAttribute("role", "tabpanel");
      panel?.setAttribute("aria-labelledby", tab.id);
      if (panel) panel.tabIndex = 0;
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        activate(tab.dataset.recipeTab!);
        history.replaceState(null, "", tab.hash);
      });
      tab.addEventListener("keydown", (event) => {
        if (event.key === " ") {
          event.preventDefault();
          tab.click();
          return;
        }
        const index = tabs.indexOf(tab);
        const next =
          event.key === "ArrowRight"
            ? (index + 1) % tabs.length
            : event.key === "ArrowLeft"
              ? (index - 1 + tabs.length) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        tabs[next].click();
        tabs[next].focus();
      });
    }
    const syncHash = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (target?.closest("#install")) return;
      const panel = target?.closest<HTMLElement>("[data-recipe-tab-panel]");
      activate(panel?.id ?? "how-it-works");
      if (target && panel && target !== panel) target.scrollIntoView();
    };
    activate("how-it-works");
    syncHash();
    window.addEventListener("hashchange", syncHash);
  }
</script>
