---
import { getCollection } from "astro:content";
import ListingLayout from "../../layouts/ListingLayout.astro";

const pages = (await getCollection("learn", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const items = pages.map((page) => ({
  href: `/learn/${page.id}/`,
  title: page.data.title,
  description: page.data.description,
  pubDate: page.data.pubDate,
}));
---

<ListingLayout
  title="Learn — Project Context for AI Coding Agents"
  description="Reference explainers on project context, context engineering, harness engineering, and the document types AI coding agents read: what the terms mean and how the pieces fit."
  sectionPath="/learn/"
  h1="Learn"
  intro="Reference explainers, not news: what project context is, how context engineering and harness engineering fit together, how git-native context differs from flat instruction files and vector memory, and what belongs in each document type."
  items={items}
>
  <p>
    For dated guides, migrations, and vendor changes, see the <a href="/blog/"
      >blog</a
    >. To put any of this to work, start with the <a href="/plugin/">plugin</a>
    or the <a href="/cli/">CLI</a>.
  </p>
</ListingLayout>
