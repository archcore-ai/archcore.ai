---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a
  href="/"
  class:list={["site-header__brand", { "site-brand--compact": compact }]}
  aria-label="Archcore home"
>
  <img class="logo-light" src="/logo-mark.png" alt="" width="67" height="66" />
  <img
    class="logo-dark"
    src="/logo-dark-mark.png"
    alt=""
    width="67"
    height="66"
  />
  <span>archcore</span>
</a>
