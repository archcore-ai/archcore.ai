---
import { LINKS } from "../lib/links";
import SiteBrand from "./SiteBrand.astro";
import { headerLinks as links, chromeLabels } from "../data/navigation";
---

<header class="site-header">
  <div class="site-header__inner">
    <SiteBrand />
    <nav class="site-header__nav" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href === LINKS.docs ? "_blank" : undefined}
            rel={link.href === LINKS.docs ? "noopener noreferrer" : undefined}
            aria-current={
              Astro.url.pathname.startsWith(link.href) ? "page" : undefined
            }
            data-en={link.en}
            data-ru={link.ru}
          >
            {link.en}
          </a>
        ))
      }
    </nav>
    <div class="site-header__actions">
      <select data-locale-select aria-label="Language" disabled>
        <option value="en">EN</option>
        <option value="ru">RU</option>
      </select>
      <a
        class="nav-star"
        href={LINKS.pluginRepo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={chromeLabels.starLabel.en}
        title={chromeLabels.starLabel.en}
        data-en-label={chromeLabels.starLabel.en}
        data-ru-label={chromeLabels.starLabel.ru}
        data-analytics-handled
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M9 19c-4.3 1.3-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-6 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          ></path>
        </svg>
        <span data-en={chromeLabels.star.en} data-ru={chromeLabels.star.ru}
          >{chromeLabels.star.en}</span
        >
      </a>
      <a
        class="nav-cta"
        href="/how-to-use/"
        data-analytics-cta="header_install"
        data-en={chromeLabels.install.en}
        data-ru={chromeLabels.install.ru}>{chromeLabels.install.en}</a
      >
      <details class="site-header__mobile">
        <summary aria-label="Navigation menu"
          ><span
            class="sr-only"
            data-en={chromeLabels.menu.en}
            data-ru={chromeLabels.menu.ru}>{chromeLabels.menu.en}</span
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
          ></summary
        >
        <nav class="site-header__nav" aria-label="Mobile navigation">
          {
            links.map((link) => (
              <a
                href={link.href}
                target={link.href === LINKS.docs ? "_blank" : undefined}
                rel={
                  link.href === LINKS.docs ? "noopener noreferrer" : undefined
                }
                data-en={link.en}
                data-ru={link.ru}
              >
                {link.en}
              </a>
            ))
          }
          <a href={LINKS.org}>GitHub ↗</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  import { initializeSiteLocale } from "../lib/site-locale";
  import { registerSuperProperties, track } from "../lib/analytics";

  initializeSiteLocale();
  document.addEventListener("archcore:theme-change", () => {
    registerSuperProperties({
      color_scheme: document.documentElement.classList.contains("dark")
        ? "dark"
        : "light",
    });
  });
  document.querySelector(".nav-star")?.addEventListener("click", () => {
    track("github_star_clicked", { repo: "plugin", surface: "navbar" });
  });

  const menu = document.querySelector<HTMLDetailsElement>(
    ".site-header__mobile"
  );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (
      menu?.open &&
      event.target instanceof Node &&
      !menu.contains(event.target)
    )
      menu.open = false;
  });
</script>
