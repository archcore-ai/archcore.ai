---
import {
  setupLabels as L,
  setupRuntimeLabels,
  installStepLabel,
  checkPromptLabel,
} from "../data/recipe-labels";

interface Props {
  downloadHref: string;
  instructions: string;
  /** Whether a joint run has been recorded, which the footer note reports. */
  verified: boolean;
  tools: { name: string; url: string }[];
}
const { downloadHref, instructions, tools, verified } = Astro.props;
const names = tools.map((tool) => tool.name);
const toolNames = { en: names.join(" and "), ru: names.join(" и ") };
const installTitle = installStepLabel(toolNames);
const checkPrompt = checkPromptLabel(toolNames);
const verificationNote = verified ? L.verifiedNote : L.experimentalNote;
const toolHref = (tool: { name: string; url: string }) =>
  tool.name === "Archcore" ? "/how-to-use/" : tool.url;
---

<dialog
  class="recipe-dialog recipe-install-dialog"
  id="install"
  aria-labelledby="setup-heading"
  open
>
  <header class="recipe-dialog__header">
    <h2 id="setup-heading" data-en={L.connect.en} data-ru={L.connect.ru}>
      {L.connect.en}
    </h2>
    <form method="dialog" data-install-close hidden>
      <button
        class="recipe-dialog__close"
        aria-label={L.closeInstall.en}
        data-en-label={L.closeInstall.en}
        data-ru-label={L.closeInstall.ru}
        autofocus>✕</button
      >
    </form>
  </header>
  <div class="recipe-install-body">
    <span id="connect" class="recipe-anchor" aria-hidden="true"></span>
    <article class="article how-to-guide recipe-install-guide">
      <section id="install-agent">
        <h3 data-en={installTitle.en} data-ru={installTitle.ru}>
          {installTitle.en}
        </h3>
        <p data-locale-block="en">
          Install {
            tools.map((tool, i) => (
              <>
                {i > 0 && " and "}
                <a
                  href={toolHref(tool)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tool.name}
                </a>
              </>
            ))
          } in the agent you use for this project.
        </p>
        <p lang="ru" data-locale-block="ru" hidden>
          Установите {
            tools.map((tool, i) => (
              <>
                {i > 0 && " и "}
                <a
                  href={toolHref(tool)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tool.name}
                </a>
              </>
            ))
          } в том агенте, которым работаете над этим проектом.
        </p>
      </section>

      <section id="install-instructions">
        <h3 data-en={L.addInstructions.en} data-ru={L.addInstructions.ru}>
          {L.addInstructions.en}
        </h3>
        <figure class="recipe-instructions" data-analytics-recipe>
          <figcaption>
            <span>CLAUDE.md / AGENTS.md / GEMINI.md</span>
            <button
              type="button"
              class="btn btn--ghost"
              data-recipe-copy
              hidden
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                <path
                  d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                ></path>
              </svg>
              <span data-copy-label data-en={L.copy.en} data-ru={L.copy.ru}
                >{L.copy.en}</span
              >
            </button>
          </figcaption>
          <pre
            id="recipe-instruction-text"
            data-recipe-text
            tabindex="0"
            aria-label={L.instructionsAria.en}
            data-en-label={L.instructionsAria.en}
            data-ru-label={L.instructionsAria.ru}>{instructions}</pre>
          <button
            type="button"
            class="recipe-instructions__toggle"
            data-recipe-expand
            aria-expanded="false"
            aria-controls="recipe-instruction-text"
            data-en={L.showFull.en}
            data-ru={L.showFull.ru}
            hidden>{L.showFull.en}</button
          >
        </figure>
        <p
          class="recipe-copy-status"
          role="status"
          aria-live="polite"
          data-copy-status
        >
        </p>
      </section>

      <section id="install-check">
        <h3 data-en={L.checkHeading.en} data-ru={L.checkHeading.ru}>
          {L.checkHeading.en}
        </h3>
        <p data-en={L.checkIntro.en} data-ru={L.checkIntro.ru}>
          {L.checkIntro.en}
        </p>
        <blockquote>
          <p data-en={checkPrompt.en} data-ru={checkPrompt.ru}>
            {checkPrompt.en}
          </p>
        </blockquote>
        <p data-en={L.checkOutro.en} data-ru={L.checkOutro.ru}>
          {L.checkOutro.en}
        </p>
      </section>
    </article>

    <footer class="recipe-install-source">
      <a
        href={downloadHref}
        data-recipe-details
        data-en={L.sourceLink.en}
        data-ru={L.sourceLink.ru}>{L.sourceLink.en}</a
      >
      <p
        class="recipe-verification-note"
        data-en={verificationNote.en}
        data-ru={verificationNote.ru}
        hidden
      >
        {verificationNote.en}
      </p>
    </footer>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  id="recipe-setup-labels"
  set:html={JSON.stringify(setupRuntimeLabels)}
/>

<script>
  import { track } from "../lib/analytics/core";
  import { getSiteLocale, SITE_LOCALE_EVENT } from "../lib/site-locale";

  type RuntimeLabels = Record<
    "copy" | "copied" | "copyHint" | "copyManual" | "showFull" | "collapse",
    string
  >;
  const labelSets = JSON.parse(
    document.getElementById("recipe-setup-labels")!.textContent!
  ) as Record<"en" | "ru", RuntimeLabels>;
  const t = (key: keyof RuntimeLabels) => labelSets[getSiteLocale()][key];

  const installDialog = document.querySelector<HTMLDialogElement>("#install");
  const installButton = document.querySelector<HTMLButtonElement>(
    "[data-recipe-install]"
  );
  if (installDialog && installButton) {
    installDialog.removeAttribute("open");
    installDialog.dataset.installReady = "true";
    installButton.hidden = false;
    installDialog.querySelector<HTMLElement>("[data-install-close]")!.hidden =
      false;
    let previousHash = "#how-it-works";
    const openInstall = () => {
      if (!installDialog.open) {
        installDialog.showModal();
        installDialog.scrollTop = 0;
      }
    };
    installButton.addEventListener("click", () => {
      previousHash = location.hash || "#how-it-works";
      openInstall();
      history.replaceState(null, "", "#install");
    });
    const syncInstallHash = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (target?.closest("#install")) {
        openInstall();
        if (target !== installDialog && target.id !== "connect")
          target.scrollIntoView({ block: "start" });
      } else if (installDialog.open) {
        installDialog.close();
      }
    };
    installDialog.addEventListener("close", () => {
      if (
        document.getElementById(location.hash.slice(1))?.closest("#install")
      ) {
        history.replaceState(null, "", previousHash);
      }
      installButton.focus({ preventScroll: true });
    });
    installDialog.addEventListener("click", (event) => {
      if (event.target !== installDialog) return;
      const rect = installDialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        installDialog.close();
    });
    syncInstallHash();
    window.addEventListener("hashchange", syncInstallHash);
  }

  const page = document.querySelector<HTMLElement>("[data-recipe-root]");
  const recipe = page?.dataset.recipe ?? "";
  const digest = page?.dataset.digest ?? "";
  const dialog = document.querySelector<HTMLDialogElement>("#recipe-details");
  const pre = document.querySelector<HTMLElement>("[data-recipe-text]");
  const feedback = document.querySelector<HTMLElement>("[data-copy-status]");
  const expandBtn = document.querySelector<HTMLButtonElement>(
    "[data-recipe-expand]"
  );
  if (expandBtn && pre) {
    expandBtn.hidden = false;
    expandBtn.addEventListener("click", () => {
      const expanded = expandBtn.getAttribute("aria-expanded") !== "true";
      expandBtn.setAttribute("aria-expanded", String(expanded));
      expandBtn.textContent = expanded ? t("collapse") : t("showFull");
      pre.classList.toggle("is-expanded", expanded);
      if (!expanded) {
        pre.scrollTop = 0;
        pre.closest("figure")?.scrollIntoView({ block: "nearest" });
      }
    });
  }
  document
    .querySelector<HTMLAnchorElement>("[data-recipe-details]")
    ?.addEventListener("click", (event) => {
      if (!dialog?.showModal) return;
      event.preventDefault();
      dialog.showModal();
    });

  dialog?.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (
      event.clientX < bounds.left ||
      event.clientX > bounds.right ||
      event.clientY < bounds.top ||
      event.clientY > bounds.bottom
    )
      dialog.close();
  });

  const copyBtn =
    document.querySelector<HTMLButtonElement>("[data-recipe-copy]");
  if (copyBtn) {
    const copyLabel = copyBtn.querySelector<HTMLElement>("[data-copy-label]")!;
    copyBtn.hidden = false;
    let reset: ReturnType<typeof setTimeout>;
    copyBtn.addEventListener("click", async () => {
      clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(pre?.textContent ?? "");
        copyLabel.textContent = t("copied");
        if (feedback) {
          feedback.dataset.messageKey = "copyHint";
          feedback.textContent = t("copyHint");
        }
        track("recipe_instructions_copied", {
          recipe,
          digest,
          host: "all",
          via: "button",
        });
        reset = setTimeout(() => {
          copyLabel.textContent = t("copy");
        }, 2200);
      } catch {
        pre?.focus();
        if (pre) window.getSelection()?.selectAllChildren(pre);
        if (feedback) {
          feedback.dataset.messageKey = "copyManual";
          feedback.textContent = t("copyManual");
        }
      }
    });
  }

  // A language switch re-renders the two strings this script owns: the
  // expand button keeps its state, and the status line keeps its message.
  window.addEventListener(SITE_LOCALE_EVENT, () => {
    if (expandBtn)
      expandBtn.textContent =
        expandBtn.getAttribute("aria-expanded") === "true"
          ? t("collapse")
          : t("showFull");
    if (feedback?.textContent?.trim()) {
      const previous = feedback.dataset.messageKey as
        | "copyHint"
        | "copyManual"
        | undefined;
      if (previous) feedback.textContent = t(previous);
    }
  });

  pre?.addEventListener("copy", () => {
    track("recipe_instructions_copied", {
      recipe,
      digest,
      host: "all",
      via: "selection",
    });
  });
</script>
