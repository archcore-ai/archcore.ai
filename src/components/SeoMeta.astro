---
/**
 * The one place every route's head tags are written.
 *
 * Each layout used to spell out its own OG and Twitter block, and they drifted:
 * two layouts shipped an OG card with no Twitter title, two more pointed every
 * page at the same site-wide image. Scrapers read this layer and nothing else,
 * so a missing tag is a missing preview. Layouts now pass the four things that
 * differ — title, description, canonical, image — and get the rest identically.
 */
interface Props {
  title: string;
  description: string;
  canonical: string;
  /** Absolute URL of the 1200×630 card. */
  image: string;
  /** Alt text for the card. Defaults to the title. */
  imageAlt?: string | undefined;
  ogType?: "website" | "article" | undefined;
  /** Raw-markdown twin of this page, when it has one. */
  markdownTwin?: string | undefined;
  publishedTime?: string | undefined;
  modifiedTime?: string | undefined;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  ogType = "website",
  markdownTwin,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<link rel="canonical" href={canonical} />
{
  markdownTwin && (
    <link rel="alternate" type="text/markdown" href={markdownTwin} />
  )
}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Archcore" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={imageAlt ?? title} />
{
  /*
    `article:*` belongs to og:type="article" only. A pillar or a recipe page is
    still dated, so a non-article page reports the same fact as og:updated_time.
  */
}
{
  ogType === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  ogType === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
{
  ogType !== "article" && modifiedTime && (
    <meta property="og:updated_time" content={modifiedTime} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@archcore_ai" />
<meta name="twitter:creator" content="@archcore_ai" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />
