---
interface Props {
  title: string;
  description: string;
  /** Russian variants. Swapped client-side by the site locale switch. */
  titleRu?: string | undefined;
  descriptionRu?: string | undefined;
}
const { title, description, titleRu, descriptionRu } = Astro.props;
---

<header class="page-intro">
  <h1
    class="page-title"
    data-en={titleRu ? title : undefined}
    data-ru={titleRu}
  >
    {title}
  </h1>
  <p
    class="page-intro__description"
    data-en={descriptionRu ? description : undefined}
    data-ru={descriptionRu}
  >
    {description}
  </p>
</header>
