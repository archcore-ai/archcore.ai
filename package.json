{
  "name": "@archcore/landing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "types": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run types && npm run lint",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "og:generate": "tsx scripts/generate-og-image.mts",
    "stars:fetch": "tsx scripts/fetch-github-stars.mts",
    "prebuild": "npm run i18n:compile && npm run og:generate && npm run stars:fetch",
    "build": "npm run check && astro build && npm run verify:build",
    "preview": "astro preview",
    "verify:build": "tsx scripts/verify-build.mts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@lingui/core": "^5.9.0",
    "@lingui/react": "^5.9.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "posthog-js": "^1.427.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.1",
    "@lingui/cli": "^5.9.0",
    "@lingui/macro": "^5.9.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-macros": "^3.1.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
