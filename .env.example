# PostHog project API key (the public, client-side "phc_..." key).
#
# One key covers all three surfaces — the SPA, the content hub (/blog, /learn,
# /alternatives) and docs.archcore.ai. The `site` super property tells them
# apart in reports, and a shared cookie on .archcore.ai keeps one visitor as
# one person across the marketing site and the docs subdomain.
#
# A production build fails without this rather than shipping a bundle whose
# analytics silently do nothing. Set ALLOW_MISSING_ANALYTICS_KEY=1 to build
# without analytics on purpose.
#
# scripts/build-content.mts mirrors these into the PUBLIC_POSTHOG_* names that
# Astro exposes to the client, so only the VITE_ names belong here.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
