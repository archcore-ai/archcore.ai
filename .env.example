# Public PostHog project key (phc_...). Shared with docs.archcore.ai.
# The site property distinguishes marketing pages from articles and integrations.
# A production build fails without this key. To build without analytics,
# set ALLOW_MISSING_ANALYTICS_KEY=1 explicitly.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
